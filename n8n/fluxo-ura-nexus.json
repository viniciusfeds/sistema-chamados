{
  "name": "Nexus Desk · URA WhatsApp",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-entrada",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Mensagem recebida (Evolution)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "c5cae0ff-6abd-4ce6-aaa1-76363bb8b2ad",
      "webhookId": "ccc48033-9ab2-47a2-a4f4-19e5523ae8ec"
    },
    {
      "parameters": {
        "jsCode": "// Mensagem recebida da Evolution API (evento messages.upsert) → telefone, nome, texto\nconst saida = [];\nfor (const item of $input.all()) {\n  const corpo = item.json.body || item.json;\n  if (corpo.event && String(corpo.event).toLowerCase().replace('_', '.') !== 'messages.upsert') continue;\n  const d = corpo.data || {};\n  const key = d.key || {};\n  // o WhatsApp às vezes identifica o contato por um código interno (@lid): usa o número real que vem junto\n  const jid = [key.remoteJid, key.remoteJidAlt, key.senderPn, d.senderPn]\n    .find(j => typeof j === 'string' && j.endsWith('@s.whatsapp.net')) || '';\n  if (key.fromMe || !jid || String(key.remoteJid || '').endsWith('@g.us')) continue;   // ignora o que nós enviamos e grupos\n  const m = d.message || {};\n  const texto = m.conversation || (m.extendedTextMessage || {}).text\n    || (m.buttonsResponseMessage || {}).selectedDisplayText || (m.listResponseMessage || {}).title\n    || (m.imageMessage || {}).caption || '[mídia]';\n  saida.push({ json: { telefone: jid.split('@')[0], nome: d.pushName || '', texto, id: key.id || '' } });\n}\nreturn saida;"
      },
      "name": "Extrair mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "id": "b76ccc05-2c4d-43b9-b34c-7c5775f40f67"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXUS_URL }}/api/integracao/whatsapp/mensagem",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Nexus-Token",
              "value": "={{ $env.NEXUS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ telefone: $json.telefone, nome: $json.nome, texto: $json.texto, id: $json.id }) }}",
        "options": {}
      },
      "name": "Nexus: URA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "id": "e26fb2b3-2bee-441e-a0c3-f41badf7afeb"
    },
    {
      "parameters": {
        "jsCode": "// Só segue se a URA do Nexus devolveu algo para responder\nreturn $input.all().filter(i => i.json.responder && i.json.texto);"
      },
      "name": "Tem resposta?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "id": "2e2fd92b-fa21-4c54-93f6-156451cc71b1"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCIA }}",
