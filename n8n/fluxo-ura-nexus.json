              "value": "={{ $env.EVOLUTION_APIKEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.telefone, text: $json.texto }) }}",
        "options": {}
      },
      "name": "Responder no WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "id": "d4f48d18-fcfc-4e67-b96c-5457cff1287e"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nexus-enviar",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Nexus pede envio",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "id": "915c8961-9ab8-462e-8170-9b43cb512820",
      "webhookId": "f44f4fc6-fe00-4a62-88dc-9d7d1b4df34d"
    },
    {
      "parameters": {
        "jsCode": "// O Nexus manda o cabeçalho X-Nexus-Token: confere antes de enviar qualquer coisa\nconst h = $input.first().json.headers || {};\nif ((h['x-nexus-token'] || '') !== $env.NEXUS_TOKEN) throw new Error('Token inválido');\nconst b = $input.first().json.body || {};\nreturn [{ json: { telefone: String(b.telefone || ''), texto: String(b.texto || ''), envio_id: b.envio_id || null } }];"
      },
      "name": "Conferir token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "id": "e2d621ed-fa5a-4384-a847-16dba3daa652"
    },
