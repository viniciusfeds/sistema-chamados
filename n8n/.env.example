# Copie para .env (nesta pasta n8n) e preencha. Gere senhas longas (ver docs/N8N.md).
# ---- Nexus
NEXUS_URL=http://host.docker.internal:9000
NEXUS_TOKEN=cole-aqui-o-mesmo-token-de-integracao-do-nexus
# ---- Evolution API (WhatsApp)
EVOLUTION_APIKEY=invente-uma-chave-longa-para-a-evolution
EVOLUTION_INSTANCIA=tecnosit
EVOLUTION_DB_SENHA=invente-uma-senha-para-o-banco-da-evolution
EVOLUTION_SERVER_URL=http://IP-DO-SERVIDOR:9610
N8N_WEBHOOK_URL=http://IP-DO-SERVIDOR:9600/
