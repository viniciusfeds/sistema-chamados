# ------------------------------------------------------------------
# Nexus Desk — arquivo de INSTALAÇÃO.
# Depois de instalado, quase tudo se ajusta em Administração → Configurações
# (vale na hora, sem editar este arquivo). Os valores abaixo servem só de padrão.
# ------------------------------------------------------------------
# Copie para .env e ajuste.
# Chave das sessões. Se ficar vazia, o sistema gera uma e guarda em dados/.secret_key
SECRET_KEY=

# Banco: SQLite (padrão) ou PostgreSQL
# DATABASE_URL=sqlite:///dados/chamados.db
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/chamados

# Primeiro administrador (criado automaticamente na primeira subida, se ainda não existir)
ADMIN_NOME=Vinicius
ADMIN_EMAIL=
ADMIN_SENHA=

# Porta do app de chamados (faixa liberada: 9000–9100)
PORTA=9000

# 1 quando estiver em HTTPS (produção)
# 1 = cookie de sessão só por HTTPS (use 1 em produção, atrás do Cloudflare). 0 só para testar por http://IP:porta
COOKIE_SEGURO=0

FUSO_HORARIO=America/Sao_Paulo
SISTEMA_NOME=Nexus Desk
EMPRESA_NOME=TecnosIT
EMPRESA_WHATSAPP=(11) 96153-8947
EMPRESA_RODAPE=TecnosIT  ·  Soluções em Tecnologia  ·  (11) 96153-8947  ·  tecnosit.com.br
RESPONSAVEL_PADRAO=TecnosIT — Segurança Eletrônica
# Cliente usado para os chamados importados/antigos (sem cliente definido)
CLIENTE_PADRAO=SkyFit Academia
CLIENTE_PADRAO_CURTO=SkyFit

# --- v1.1 ---
# Endereço público do sistema (usado nos links do WhatsApp/e-mail). Ex.: https://chamados.tecnosit.com.br
URL_PUBLICA=

# Horas sem nova ação para o chamado ser marcado como "parado", por prioridade
ALERTA_HORAS_URGENTE=4
ALERTA_HORAS_ALTA=12
ALERTA_HORAS_NORMAL=48
ALERTA_HORAS_BAIXA=120

# Inventário: chave das senhas dos equipamentos. Deixe vazio para gerar sozinha em dados/.chave_inventario.
# Se preencher, use uma chave Fernet: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
INVENTARIO_CHAVE=

# Monitoramento do inventário (teste de conexão TCP)
MONITOR_ATIVO=1
MONITOR_INTERVALO_MIN=5
MONITOR_FALHAS=2
MONITOR_TIMEOUT=4
# Ocorrências: chamado automático quando um equipamento monitorado cai
MONITOR_ABRIR_CHAMADO=1
MONITOR_PRIORIDADE=alta
MONITOR_AGRUPAR_MIN=15
MONITOR_REABRIR_MIN=30
MONITOR_FECHAR_AO_VOLTAR=1
MONITOR_AVISAR_CLIENTE=0

# Fotos
FOTO_MAX_MB=15
FOTO_MAX_POR_ENVIO=6

# Aviso por e-mail de chamado aberto pelo link (opcional). Ex. Gmail: smtp.gmail.com, porta 587, senha de app
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
AVISO_EMAILS=

# --- v1.2: WhatsApp automático (API oficial da Meta). Passo a passo: docs/WHATSAPP.md ---
# Integração do WhatsApp: meta (oficial) / n8n / desligado — também em Configurações → WhatsApp
WHATSAPP_MODO=meta
WHATSAPP_URA=1
# Modo n8n (ver docs/N8N.md): webhook do n8n que envia, e token trocado entre Nexus e n8n (24+ caracteres)
N8N_URL_ENVIO=
N8N_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSAO=v23.0
WHATSAPP_IDIOMA=pt_BR
WHATSAPP_MODELO_ABERTO=chamado_aberto
WHATSAPP_MODELO_ATUALIZADO=chamado_atualizado
WHATSAPP_MODELO_CONCLUIDO=chamado_concluido
# Webhook (opcional, para status entregue/lido)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- v1.8: Faturamento — dados da empresa (emitente) -------------------------------------------
# (tudo isto também pode ser ajustado em Administração → Configurações; a tela tem prioridade)
EMPRESA_RAZAO=TecnosIT Soluções em Tecnologia Ltda
EMPRESA_CNPJ=32.402.010/0001-40
EMPRESA_IE=
EMPRESA_IM=
EMPRESA_LOGRADOURO=Av. Salgado Filho
EMPRESA_NUMERO=2120
EMPRESA_COMPLEMENTO=Sala 2112C
EMPRESA_BAIRRO=Centro
EMPRESA_CEP=
EMPRESA_MUNICIPIO=Guarulhos
EMPRESA_UF=SP
EMPRESA_IBGE=3518800
EMPRESA_TELEFONE=(11) 9190-1336
EMPRESA_EMAIL=
EMPRESA_SITE=tecnosit.com.br

# Orçamentos e cobrança
ORC_NUMERO_INICIAL=1
ORC_VALIDADE_DIAS=15
ORC_IMPOSTO_PRODUTOS_PCT=0
ORC_IMPOSTO_SERVICOS_PCT=0
ORC_CONDICOES=50% na aprovação e 50% na entrega.
ORC_GARANTIA=90 dias para serviços; equipamentos conforme garantia do fabricante.
ORC_OBSERVACOES=
FIN_PIX_CHAVE=
FIN_DADOS_BANCARIOS=
FIN_MULTA_PCT=2
FIN_JUROS_MES_PCT=1

# --- v1.9: Banco Inter — boleto com PIX ----------------------------------------------------------
# Internet Banking PJ → Soluções para sua empresa → Nova Integração (permissões de Boleto/Cobrança)
INTER_ATIVO=0
INTER_AMBIENTE=producao
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CONTA=
INTER_DIAS_AGENDA=30
# Certificado: copie inter.crt e inter.key para a pasta certificados/ (ao lado deste .env)
INTER_CERT_ARQUIVO=certificados/inter.crt
INTER_CHAVE_ARQUIVO=certificados/inter.key

# ---------- Certificado digital A1 da empresa (emissão de NF-e / NFS-e)
# O jeito mais fácil é enviar o .pfx em Administração → Configurações → Certificado digital A1.
# Alternativa: copie o .pfx para a pasta certificados/ e informe aqui (a tela tem prioridade).
CERT_A1_ARQUIVO=
CERT_A1_SENHA=

