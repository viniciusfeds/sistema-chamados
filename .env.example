# Copie para .env e ajuste.
# Chave das sessões. Se ficar vazia, o sistema gera uma e guarda em dados/.secret_key
SECRET_KEY=

# Banco: SQLite (padrão) ou PostgreSQL
# DATABASE_URL=sqlite:///dados/chamados.db
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/chamados

# Primeiro administrador (criado automaticamente na primeira subida, se ainda não existir)
ADMIN_NOME=Vinicius
ADMIN_EMAIL=
ADMIN_SENHA=

# Porta do app de chamados (faixa liberada: 9000–9100)
PORTA=9000

# 1 quando estiver em HTTPS (produção)
COOKIE_SEGURO=0

FUSO_HORARIO=America/Sao_Paulo
EMPRESA_NOME=TecnosIT
EMPRESA_WHATSAPP=(11) 96153-8947
EMPRESA_RODAPE=TecnosIT  ·  Soluções em Tecnologia  ·  (11) 96153-8947  ·  tecnosit.com.br
RESPONSAVEL_PADRAO=TecnosIT — Segurança Eletrônica
# Cliente usado para os chamados importados/antigos (sem cliente definido)
CLIENTE_PADRAO=SkyFit Academia
CLIENTE_PADRAO_CURTO=SkyFit
